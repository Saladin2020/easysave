{
  "name": "easysave",
  "version": "0.1.0",
  "description": "Local CLI + web tool for game save slots (schema, migrations, checksum, autosave rotation, backup) and Thai / English / Malay string tables (extract from Easy Dialogue, Quest, UI and Items; CSV / PO round trip), exported as a Godot 4.3+ SaveManager + TranslationServer setup or a web localStorage + i18n runtime",
  "type": "module",
  "bin": {
    "easysave": "./dist/cli.js"
  },
  "files": [
    "dist",
    "runtime",
    "samples",
    "assets",
    "web/dist",
    "README.md",
    "CREDITS.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts serve --dev",
    "build": "npm run build:runtime && npm run build:server && npm run build:web",
    "build:server": "tsup src/cli.ts src/mcp/server.ts --format esm --dts --clean --out-dir dist",
    "build:web": "vite build --config web/vite.config.ts",
    "serve": "tsx src/cli.ts serve",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:http": "tsx src/mcp/server.ts --http --port 8899",
    "init": "tsx src/cli.ts init",
    "icons": "tsx scripts/write-icons.mts",
    "capture:ui": "python3 scripts/capture-ui.py",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:tools": "node scripts/smoke-mcp-tools.mjs",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "smoke": "npm run smoke:tools && npm run smoke:cli",
    "preview": "node scripts/render-docs.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "check:runtime": "node scripts/build-runtime.mjs --check",
    "check:web": "python3 scripts/check-web.py",
    "samples": "tsx scripts/make-samples.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.3",
    "hono": "^4.13.18",
    "open": "^10.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
